#: merineo-product-badges.php:43
msgid "Settings"
msgstr "Nastavení"

#: inc/Admin/Settings_Page.php:358
msgid "Status: Active now. Badge shows only on products where this rule applies (and is valid for current user)."
msgstr "Stav: Právě aktivní. Štítek se zobrazí jen u produktů, na které se pravidlo vztahuje (a je platné pro aktuálního uživatele)."

#: inc/Admin/Settings_Page.php:359
msgid "Status: Not active now (schedule/conditions/user). Badge will start showing automatically once the rule becomes active and applies."
msgstr "Stav: Momentálně neaktivní (plánování/podmínky/uživatel). Štítek se začne zobrazovat automaticky, jakmile se pravidlo stane aktivním a bude se vztahovat na produkt."

#: inc/Admin/Settings_Page.php:378
msgid "Badges are rendered in this order (when active): Recommended, Sale, Promotions (YITH), Dynamic pricing (YITH), Multipack, New, Bestseller, Stock status, Category, Product-specific."
msgstr "Štítky se vykreslují v tomto pořadí (pokud jsou aktivní): Doporučené, Sleva, Akce (YITH), Dynamické ceny (YITH), Multipack, Novinka, Nejprodávanější, Stav skladu, Kategorie, Produktové."

